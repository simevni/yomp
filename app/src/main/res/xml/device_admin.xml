<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal device-admin policy. Required so Yomp can be set as Device Owner
     (via `adb shell dpm set-device-owner ...`) and drive Lock Task (kiosk) mode. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
